# Tempo e comportamento
default-timeout=4000
ignore-timeout=1
max-visible=3
layer=overlay
anchor=top-right

# Visual (paleta do waybar)
font=Noto Sans Mono 9
background-color=#14161cd9
text-color=#c8ccd4
border-color=#2a2e37
border-size=1
border-radius=0
padding=8
margin=8
width=320
height=120
icons=1
max-icon-size=32

[urgency=low]
default-timeout=2500
text-color=#6b7280

[urgency=critical]
border-color=#e06c75
default-timeout=0
