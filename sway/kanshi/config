# Só o notebook
profile notebook {
	output eDP-1 enable mode 1920x1080@60.003Hz position 0,0 scale 1
}

# Notebook à esquerda + projetor Epson à direita
profile projetor {
	output "Seiko Epson Corporation EPSON PJ 0x01010101" enable mode --custom 1920x1080@59.810Hz position 1920,0 scale 1 transform normal
	output "KDB 0x0526 Unknown" enable mode 1920x1080@60.003Hz position 0,0 scale 1 transform normal
}
