# Sway da tela de login (SDDM). Baseado em /etc/sway/sddm-greeter.config do Fedora.
xwayland disable
swaybg_command -
default_border none

# Mesmo teclado da sessão: US e ABNT2, alterna com Ctrl+Space
input type:keyboard {
    xkb_layout "us,br"
    xkb_variant ",abnt2"
    xkb_options "grp:ctrl_space_toggle"
    xkb_numlock enabled
}

# Toque para clicar, igual à sessão
input type:touchpad {
    tap enabled
    dwt disabled
}

# Tampa fechada (notebook na dock): login só no monitor externo
bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

# Menu de energia por teclado (os botões também estão no tema)
bindsym Mod4+Shift+e exec swaynag \
        -t warning \
        -m 'O que você quer fazer?' \
        -b 'Desligar' 'systemctl poweroff' \
        -b 'Reiniciar' 'systemctl reboot' \
        -b 'Suspender' 'systemctl suspend'

# Apaga as telas após 1 min parado na tela de login
exec command -v swayidle >/dev/null && swayidle -w \
        timeout 60 'swaymsg "output * power off"' \
             resume 'swaymsg "output * power on"'

for_window [app_id="sddm-greeter"] fullscreen enable
